 "earlyBasis": {
  "road:qgis:tjudo:getavagen-100km1": "Dagens väg genom Tjudö är vägen på sockenkartan 1927 och utgåvan 1941 (inom kartans lägesfel), utom vid Fenell och Dala: där gick vägen i en båge österut förbi Lignell. Dagens diagonal där ritas första gången på grundkartan 1968.",
  "road:qgis:geta:getavagen-1-200km2": "Dagens väg genom Geta är vägen på sockenkartan 1927 och utgåvan 1941, utom vid Östergeta: där gick vägen i en kurva österut, dagens Skräddarsvägen. Dagens raka sträcka där ritas första gången på grundkartan 1984.",
  "road:qgis:geta:skraddarsvagen-200km2": "Den gamla huvudvägen i kurvan vid Östergeta. Sockenkartan 1927, utgåvan 1941 och grundkartan 1968 ritar den som landsvägen; dagens raka sträcka ritas först 1984."
 },
 "laterStageNote": "Objektets hela geometri: diagonalen vid Fenell ritas från grundkartan 1968.",
 "laterStageBasis": {
  "road:qgis:tjudo:getavagen-100km1": "Grundkartan 1968 ritar dagens diagonal vid Fenell som huvudväg; den gamla bågen förbi Lignell ritas där som en mindre väg."
 },
 "geometryNote": "Del av objektets egen geometri (samma koordinater) där vägen är vägen på sockenkartan 1927.",
