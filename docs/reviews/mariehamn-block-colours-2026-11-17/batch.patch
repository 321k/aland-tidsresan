+ const {box,model}=setup(),grid=new box.Grid(()=>{});
+ Object.assign(grid,read('dist/assets/mariehamn-city-grid.json'));grid.ready=true;grid.objects=model;
+ const fills={},seen={};let owner=new Map();
+ const ctx=new Proxy({measureText:s=>({width:s.length*6}),fill(path){const f=owner.get(path);if(f&&['block','builtUp'].includes(f.kind)){(fills[f.kind]??=new Set()).add(ctx.fillStyle);seen[f.planned||f.objectResolution?.state==='planned'?'planned':f.kind]=1}}},
